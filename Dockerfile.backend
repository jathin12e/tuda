# Signal server: relays the "button pressed" alert to the operator screen.
# It has no dependencies, so there is nothing to install.
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

COPY server ./server

RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4000/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server/index.mjs"]
